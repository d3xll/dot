// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
    ],
    "modules-center": [
        "hyprland/workspaces",
        "clock"
    ],
    "modules-right": [
        "wireplumber#source",
        "pulseaudio",
        "custom/notification"
    ],

    //Modules configuratio
    "include": [
		"~/.config/waybar/modules.json"
	]
}
